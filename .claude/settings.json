{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build-loop.sh" } ] },
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/build-learn/runtime.py --project \"$CLAUDE_PROJECT_DIR\" hook", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/build-learn/runtime.py --project \"$CLAUDE_PROJECT_DIR\" hook", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/build-learn/runtime.py --project \"$CLAUDE_PROJECT_DIR\" hook", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__.*[Ll][Ii][Nn][Ee][Aa][Rr].*__(create|update|save)_issue",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/build-learn/runtime.py --project \"$CLAUDE_PROJECT_DIR\" hook", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*[Ll][Ii][Nn][Ee][Aa][Rr].*__(create|update|save)_issue",
        "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/build-learn/runtime.py --project \"$CLAUDE_PROJECT_DIR\" hook", "timeout": 5 } ] }
    ]
  }
}
